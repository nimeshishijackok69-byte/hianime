{
  "manifest_version": 3,
  "name": "Hianime Live Japanese Subtitles",
  "description": "Live Japanese subtitles from shared tab audio using Deepgram streaming transcription.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Live subtitles",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src wss://api.deepgram.com https://api.deepgram.com;"
  }
}
